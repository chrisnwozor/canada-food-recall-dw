{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.13.0/schema.json",
  "name": "lineByYear",
  "position": {
    "x": 640,
    "y": 170,
    "z": 5000,
    "height": 420,
    "width": 860,
    "tabOrder": 5000
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "mart dim_date"
                    }
                  },
                  "Property": "year"
                }
              },
              "queryRef": "mart dim_date.year",
              "nativeQueryRef": "year",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "mart fact_recall"
                    }
                  },
                  "Property": "Total Recalls"
                }
              },
              "queryRef": "mart fact_recall.Total Recalls",
              "nativeQueryRef": "Total Recalls"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Food recalls per year'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}